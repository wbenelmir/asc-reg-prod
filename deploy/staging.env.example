# ASC 2026 Registration Platform -- staging configuration template.
#
# PLACEHOLDERS ONLY. Copy the variable NAMES into the deployment's own secret
# store or environment injection; never commit real values, never put them in
# a ticket, a log or an archive. Values marked __SET_BY_OPERATOR__ are
# supplied by the operations team. The non-secret defaults shown can be kept.
# See docs/deployment/README.md for what each group means.
#
# Every process (web, workers, beat) gets this environment. The migration
# process gets the same environment with two changes (README, "Migrations"):
#   DJANGO_SETTINGS_MODULE=config.settings.staging_migration
#   DATABASE_MIGRATION_PASSWORD=__SET_BY_OPERATOR__   (migration process ONLY)
# and DATABASE_PASSWORD may then be left out. A runtime process refuses to
# start when DATABASE_MIGRATION_PASSWORD is present.
#
# Multi-line PEM keys go on one line with literal \n sequences.

# --- Settings module (REQUIRED) -------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.staging

# --- Django core (REQUIRED) -----------------------------------------------------
DJANGO_SECRET_KEY=__SET_BY_OPERATOR__
# Comma-separated host names the site answers to.
DJANGO_ALLOWED_HOSTS=__SET_BY_OPERATOR__
# Absolute https:// origin, no path, query or credentials (used in emailed links).
DJANGO_PUBLIC_BASE_URL=__SET_BY_OPERATOR__

# --- PostgreSQL 17 (REQUIRED) ---------------------------------------------------
DATABASE_HOST=__SET_BY_OPERATOR__
DATABASE_PORT=5432
DATABASE_NAME=__SET_BY_OPERATOR__
# The restricted runtime role (web, workers, beat).
DATABASE_USER=__SET_BY_OPERATOR__
DATABASE_PASSWORD=__SET_BY_OPERATOR__
# The migration-owner role NAME (every process). Its password is given to the
# migration process only.
DATABASE_MIGRATION_USER=__SET_BY_OPERATOR__
# OPTIONAL: persistent connections in seconds (default 0).
DATABASE_CONN_MAX_AGE=0

# --- Redis: two separate databases, both TLS (REQUIRED) -------------------------
# Celery broker. rediss:// with a host and a database index. For a private CA
# add ?ssl_ca_certs=/path/to/ca.pem; never ssl_cert_reqs=none.
CELERY_BROKER_URL=__SET_BY_OPERATOR__
# Shared ALTCHA challenge counter: a DIFFERENT database (or instance) from the
# broker, rediss://, eviction policy noeviction.
REDIS_URL=__SET_BY_OPERATOR__
# OPTIONAL counter limits (provisional engineering defaults, not capacity figures).
HUMAN_CHECK_CHALLENGE_MAX_PER_WINDOW=60
HUMAN_CHECK_CHALLENGE_WINDOW_SECONDS=600
HUMAN_CHECK_CHALLENGE_FALLBACK_MAX_PER_WINDOW=20

# --- Private document storage: S3-compatible bucket (REQUIRED) ------------------
S3_STORAGE_BUCKET_NAME=__SET_BY_OPERATOR__
S3_STORAGE_ENDPOINT_URL=__SET_BY_OPERATOR__
S3_STORAGE_ACCESS_KEY_ID=__SET_BY_OPERATOR__
S3_STORAGE_SECRET_ACCESS_KEY=__SET_BY_OPERATOR__
S3_STORAGE_REGION_NAME=__SET_BY_OPERATOR__

# --- Malware scanning: ClamAV clamd (REQUIRED) ----------------------------------
# Exactly ONE of CLAMD_SOCKET_PATH (Unix socket) or CLAMD_HOST (private TCP).
CLAMD_SOCKET_PATH=
CLAMD_HOST=__SET_BY_OPERATOR__
CLAMD_PORT=3310
# OPTIONAL bounds. CLAMD_MAX_STREAM_BYTES must not exceed clamd StreamMaxLength
# and must be at least the largest accepted upload (8 MiB by default).
CLAMD_CONNECT_TIMEOUT_SECONDS=5
CLAMD_SCAN_TIMEOUT_SECONDS=60
CLAMD_MAX_STREAM_BYTES=26214400

# --- SMTP (REQUIRED) ------------------------------------------------------------
EMAIL_HOST=__SET_BY_OPERATOR__
EMAIL_PORT=587
# STARTTLS (587) or implicit TLS (EMAIL_USE_SSL=True, usually 465); not both.
# Plain SMTP is accepted only to a relay on the same host (127.0.0.1).
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Both or neither.
EMAIL_HOST_USER=__SET_BY_OPERATOR__
EMAIL_HOST_PASSWORD=__SET_BY_OPERATOR__
EMAIL_TIMEOUT_SECONDS=10
# The sender, for example: ASC 2026 <no-reply@your-domain>
DEFAULT_FROM_EMAIL=__SET_BY_OPERATOR__

# --- Key families (REQUIRED). Generate new values; never reuse local ones. -----
RATE_LIMIT_HMAC_ACTIVE_VERSIONS=1
RATE_LIMIT_HMAC_WRITE_VERSION=1
RATE_LIMIT_HMAC_KEY_V1=__SET_BY_OPERATOR__
IDENTITY_ENCRYPTION_ACTIVE_VERSIONS=1
IDENTITY_ENCRYPTION_WRITE_VERSION=1
IDENTITY_ENCRYPTION_KEY_V1=__SET_BY_OPERATOR__
IDENTITY_BLIND_INDEX_HMAC_ACTIVE_VERSIONS=1
IDENTITY_BLIND_INDEX_HMAC_WRITE_VERSION=1
IDENTITY_BLIND_INDEX_HMAC_KEY_V1=__SET_BY_OPERATOR__
# REQUIRED for Digital Entry Pass issuance: a PEM P-256 private key (one line).
QR_SIGNING_ACTIVE_KEY_VERSIONS=1
QR_SIGNING_WRITE_KEY_VERSION=1
QR_SIGNING_KEY_V1=__SET_BY_OPERATOR__

# --- Reverse proxy and HTTPS ----------------------------------------------------
# REQUIRED behind a TLS-terminating proxy: True, plus the proxy's address range.
TRUSTED_PROXY_FORWARDING_ENABLED=__SET_BY_OPERATOR__
TRUSTED_PROXY_CIDRS=__SET_BY_OPERATOR__
# OPTIONAL HSTS rollout (defaults: one year, subdomains, preload).
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# --- Application server (OPTIONAL; python -m config.serve) ----------------------
ASC_HTTP_LISTEN=127.0.0.1:8000
ASC_HTTP_THREADS=8

# --- Ministry NIN service (OPTIONAL; disabled unless the owner authorizes it) ---
# Without these, every Algerian case goes to manual review. See
# docs/operations/identity_provider_integration_guide.md before setting any.
NIN_PROVIDER_BACKEND=apps.people.nin_provider.DisabledNinProvider
MINISTRY_NIN_API_BASE_URL=
MINISTRY_NIN_API_USERNAME=
MINISTRY_NIN_API_PASSWORD=
MINISTRY_NIN_API_AUTH_TOKEN_PATH=

# --- MFA step-up provider (OPTIONAL; without it the emergency wipe is unavailable)
MFA_BACKEND=
