msgstr "هذا غير ممكن في الحالة الحالية للحساب."

msgid "The end of validity must follow its start."
msgstr "يجب أن تأتي نهاية الصلاحية بعد بدايتها."

msgid "A temporary external-security account and its roles need a future end of validity."
msgstr "يحتاج حساب الأمن الخارجي المؤقت وأدواره إلى نهاية صلاحية في المستقبل."

msgid "An account already uses this email address."
msgstr "يستخدم حساب آخر عنوان البريد الإلكتروني هذا بالفعل."

msgid "Enter a valid email address."
msgstr "أدخل عنوان بريد إلكتروني صالحًا."

msgid "Enter a display name."
msgstr "أدخل اسم العرض."

msgid "Choose an account type from the list."
msgstr "اختر نوع الحساب من القائمة."

msgid "Choose a role from the list."
msgstr "اختر دورًا من القائمة."

msgid "Choose an event edition, or every event edition."
msgstr "اختر دورة، أو جميع الدورات."

msgid "This role cannot have this scope. Check the organization and the checkpoint."
msgstr "لا يمكن لهذا الدور أن يحمل هذا النطاق. تحقق من المؤسسة ونقطة التفتيش."

msgid "This role is no longer on the account. Reload the page."
msgstr "لم يعد هذا الدور مرتبطًا بالحساب. أعد تحميل الصفحة."

msgid "This change could not be applied. Reload the page and try again."
msgstr "تعذّر تطبيق هذا التغيير. أعد تحميل الصفحة وحاول مرة أخرى."

msgid "Invited"
msgstr "مدعو"

msgid "Disabled"
msgstr "معطّل"

msgid "Cannot sign in: the account is not active or outside its validity."
msgstr "لا يمكن تسجيل الدخول: الحساب غير نشط أو خارج فترة صلاحيته."

msgid "Active, but no password set yet: send a setup link."
msgstr "نشط، لكن لم تُعيَّن كلمة مرور بعد: أرسل رابط إعداد."

msgid "Active, but no current role: the account opens no area."
msgstr "نشط، لكن دون دور حالي: لا يفتح الحساب أي قسم."

msgid "Can sign in and use its current roles."
msgstr "يمكنه تسجيل الدخول واستخدام أدواره الحالية."

msgid "In effect"
msgstr "ساري المفعول"

msgid "Starts later"
msgstr "يبدأ لاحقًا"

msgid "Ended"
msgstr "منتهٍ"

msgid "The account was created as Invited. Next: send a setup link, activate it and grant a role -- three separate steps."
msgstr "أُنشئ الحساب بحالة «مدعو». التالي: أرسل رابط إعداد، ثم فعّله، ثم امنحه دورًا -- ثلاث خطوات منفصلة."

msgid "The account was updated."
msgstr "حُدّث الحساب."

#, python-format
msgid "The account status is now: %(status)s."
msgstr "حالة الحساب الآن: %(status)s."

msgid "A single-use link was sent to the account's email address. Any earlier link no longer works."
msgstr "أُرسل رابط للاستخدام مرة واحدة إلى البريد الإلكتروني للحساب. لم يعد أي رابط سابق صالحًا."

msgid "The role was granted. It applies on the next request."
msgstr "مُنح الدور. يسري بدءًا من الطلب التالي."

msgid "The role was ended. It no longer applies."
msgstr "أُنهي الدور. لم يعد ساريًا."

msgid "Your password is set. You can now sign in."
msgstr "عُيّنت كلمة المرور. يمكنك الآن تسجيل الدخول."

msgid "Your password is set. You can sign in once an administrator has activated your account."
msgstr "عُيّنت كلمة المرور. يمكنك تسجيل الدخول بعد أن يفعّل مسؤول حسابك."

msgid "Type the characters shown in the security image."
msgstr "اكتب الأحرف الظاهرة في صورة التحقق."

msgid "This security image is not valid for this page (it was already used, or it belongs to another page or tab). Type the characters of the new image."
msgstr "صورة التحقق هذه غير صالحة لهذه الصفحة (استُخدمت من قبل، أو تخص صفحة أو علامة تبويب أخرى). اكتب أحرف الصورة الجديدة."

msgid "The security image expired. Type the characters of the new image."
msgstr "انتهت صلاحية صورة التحقق. اكتب أحرف الصورة الجديدة."

msgid "The characters did not match the image. Type the characters of the new image."
msgstr "الأحرف لا تطابق الصورة. اكتب أحرف الصورة الجديدة."

msgid "Characters in the image"
msgstr "الأحرف الظاهرة في الصورة"

msgid "Short and factual. Do not include personal data."
msgstr "موجز وواقعي. لا تُدرج أي بيانات شخصية."

msgid "Coordinated Universal Time (UTC). Leave empty for no limit."
msgstr "التوقيت العالمي المنسّق (UTC). اتركه فارغًا لعدم وضع حد."

msgid "Internal staff"
msgstr "موظفون داخليون"

msgid "Organization staff"
msgstr "موظفو مؤسسة"

msgid "Support"
msgstr "الدعم"

msgid "External security (temporary)"
msgstr "أمن خارجي (مؤقت)"

msgid "Display name"
msgstr "اسم العرض"

msgid "Account type"
msgstr "نوع الحساب"

msgid "Starts"
msgstr "البداية"

msgid "Ends"
msgstr "النهاية"

msgid "I confirm this role applies to every event edition."
msgstr "أؤكد أن هذا الدور يسري على جميع الدورات."

msgid "Select a role"
msgstr "اختر دورًا"

msgid "Select an event edition"
msgstr "اختر دورة"

msgid "Every event edition"
msgstr "جميع الدورات"

